{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@flowblade/devtools/typescript/tsconfig.base.json",
  "exclude": [
    "**/node_modules",
    "**/.*/*",
    "dist",
    "coverage",
    "oxlint.config.ts"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.json"
  ]
}
