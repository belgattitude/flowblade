{
  "name": "@examples/base-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf ./.next ./coverage ./tsconfig.tsbuildinfo",
    "codegen-db": "tsx scripts/generate-db-base-auth-types.ts",
    "format": "dx-oxfmt --write",
    "generate-better-auth-migrations": "better-auth generate",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.14",
    "@flowblade/core": "workspace:^",
    "@flowblade/source-kysely": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "better-auth": "1.7.14",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.14",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@dotenvx/dotenvx": "2.38.2",
    "@flowblade/dx": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "better-call": "1.4.4",
    "dotenv": "18.0.9",
    "kysely": "0.29.7",
    "kysely-codegen": "0.20.0",
    "picocolors": "1.1.1",
    "rimraf": "6.1.3",
    "tarn": "3.1.2",
    "tedious": "20.3.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "kysely": "^0.29.0",
    "tarn": "^3.0.2",
    "tedious": "^20.2.3"
  },
  "peerDependenciesMeta": {
    "tarn": {
      "optional": true
    },
    "tedious": {
      "optional": true
    }
  }
}
