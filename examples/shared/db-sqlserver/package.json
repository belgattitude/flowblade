{
  "name": "@examples/db-sqlserver",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "examples/shared/db-sqlserver"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    },
    "./kysely-types": {
      "types": "./dist/kysely-types.d.ts",
      "default": "./dist/kysely-types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf ./.next ./coverage ./tsconfig.tsbuildinfo",
    "codegen": "run-s codegen-prisma codegen-ddl",
    "codegen-ddl": "tsx ./scripts/create-ddl.ts",
    "codegen-prisma": "PRISMA_DISABLE_AI_AGENT_CHECK=true prisma generate",
    "db-drop": "PRISMA_DISABLE_AI_AGENT_CHECK=true dotenvx run -- pnpm prisma db push --schema=./prisma/schema.reset.prisma --force-reset",
    "db-recreate": "pnpm run db-drop && tsx ./scripts/db-recreate.ts && pnpm run codegen",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "prisma-db-pull": "PRISMA_DISABLE_AI_AGENT_CHECK=true dotenvx run -- pnpm prisma db pull",
    "prisma-db-push": "PRISMA_DISABLE_AI_AGENT_CHECK=true dotenvx run -- pnpm prisma db push && run codegen",
    "prisma-db-reset-push": "pnpm run db-recreate",
    "prisma-db-seed": "PRISMA_DISABLE_AI_AGENT_CHECK=true dotenvx run -- pnpm prisma db seed",
    "prisma-format": "PRISMA_DISABLE_AI_AGENT_CHECK=true prisma format",
    "prisma-generate": "PRISMA_DISABLE_AI_AGENT_CHECK=true prisma generate",
    "prisma-migrate": "PRISMA_DISABLE_AI_AGENT_CHECK=true dotenvx run -- pnpm prisma migrate",
    "prisma-migrate-reset": "PRISMA_DISABLE_AI_AGENT_CHECK=true dotenvx run -- pnpm prisma migrate reset",
    "prisma-studio": "PRISMA_DISABLE_AI_AGENT_CHECK=true dotenvx run -- pnpm prisma studio",
    "prisma-validate": "PRISMA_DISABLE_AI_AGENT_CHECK=true prisma validate",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "7.10.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.35.0",
    "@faker-js/faker": "10.6.0",
    "@flowblade/core": "workspace:^",
    "@flowblade/dx": "workspace:*",
    "@flowblade/sql-tag": "workspace:^",
    "@httpx/assert": "0.18.0",
    "@prisma/client": "7.10.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "execa": "10.1.0",
    "kysely": "0.29.6",
    "npm-run-all2": "9.0.3",
    "prisma": "7.10.0",
    "prisma-kysely": "3.2.1",
    "prisma-markdown": "4.0.0",
    "regexp.escape": "2.0.1",
    "rimraf": "6.1.3",
    "tedious": "20.3.7",
    "tinyrainbow": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@prisma/client": "^7.10.0",
    "kysely": "^0.29.0",
    "tedious": "^20.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  }
}
