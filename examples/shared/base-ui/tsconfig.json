{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@flowblade/devtools/typescript/tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"],
    "jsx": "react-jsx"
  },
  "exclude": [
    "**/node_modules",
    "dist",
    "coverage",
    "storybook-static",
    "oxlint.config.ts"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.json",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ]
}
