{
  "name": "@examples/base-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config.mjs": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build-storybook": "storybook build",
    "bump-ui": "shadcn add --all --overwrite -c . && pnpm lint-fix",
    "bump-ux": "shadcn add sidebar-07 -o && pnpm lint-fix",
    "check": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "clean": "rimraf ./.next ./coverage ./tsconfig.tsbuildinfo",
    "doctor": "react-doctor",
    "fix": "dx-oxlint --fix && dx-oxfmt --write",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "next-themes": "0.4.6",
    "react-day-picker": "10.0.2",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@flowblade/dx": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.60.0",
    "nock": "15.0.4",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-doctor": "0.9.18",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-resizable-panels": "4.14.7",
    "recharts": "3.10.1",
    "rimraf": "6.1.3",
    "shadcn": "4.22.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.14.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
