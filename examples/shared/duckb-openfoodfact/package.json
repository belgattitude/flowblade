    "@types/node": "26.6.5",
    "boxen": "9.0.0",
    "cross-env": "10.1.0",
    "dedent": "1.7.2",
    "execa": "10.2.1",
    "hono": "4.13.14",
    "kysely": "0.29.7",
    "node-downloader-helper": "2.1.11",
    "npm-run-all2": "9.0.4",
    "pretty-bytes": "7.2.0",
    "regexp.escape": "2.0.1",
    "rimraf": "6.1.3",
    "sql-formatter": "15.9.0",
    "tinyrainbow": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yocto-spinner": "1.2.2"
