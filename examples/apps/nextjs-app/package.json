  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "examples/apps/nextjs-app"
  },
  "type": "module",
  "imports": {
    "#cli/*.ts": "./scripts/cli/*.ts",
    "#*.ts": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx ./scripts/install-local-fonts.ts && next dev",
    "dev-bun": "tsx ./scripts/install-local-fonts.ts && bun --bun run next dev",
    "build": "tsx ./scripts/install-local-fonts.ts && next build",
    "build-bun": "tsx ./scripts/install-local-fonts.ts && bun --bun run next build",
    "typegen": "next typegen",
    "install-local-fonts": "tsx ./scripts/install-local-fonts.ts",
    "build-no-paths": "tsx ./scripts/install-local-fonts.ts && cross-env NEXT_BUILD_TSCONFIG=./tsconfig.no-paths.json next build",
    "build-standalone": "tsx ./scripts/install-local-fonts.ts && cross-env NEXT_BUILD_OUTPUT=standalone next build",
    "build-pruned": "pnpm --workspace-root turbo prune @examples/nextjs-app --docker --out-dir=./.turbo-pruned/nextjs-app/",
    "bundle-analyze": "next experimental-analyze",
    "start": "next start",
    "clean": "rimraf ./.next ./coverage ./tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "next typegen && tsc --project tsconfig.json --noEmit",
    "typecheck-no-paths": "next typegen && tsc --project tsconfig.no-paths.json --noEmit",
    "lint": "next typegen && ultracite check",
    "lint-fix": "next typegen && ultracite fix",
    "format": "oxfmt --write",
    "codegen": "run-s codegen-api",
    "codegen-api": "tsx ./scripts/codegen-openapi-json-schema.ts && orval --config ./orval.config.ts",
    "docker:build-nodejs": "cd docker && docker compose --file ./docker-compose-nodejs.yml build",
    "docker:build-bun": "cd docker && docker compose --file ./docker-compose-bun.yml build",
    "docker:compare": "tsx ./scripts/docker-compare-images.ts",
    "doctor": "react-doctor",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
