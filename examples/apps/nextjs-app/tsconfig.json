{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@flowblade/dx/typescript/tsconfig.nextjs.json",
  "compilerOptions": {
    "paths": {
      "@examples/base-auth": ["../../shared/base-auth/src/index"],
      "@examples/db-sqlserver/kysely-types": [
        "../../shared/db-sqlserver/src/kysely-types.ts"
      ],
      "@examples/base-ui/postcss.config.mjs": [
        "../../shared/base-ui/postcss.config.mjs"
      ],
      "@examples/base-ui/*": ["../../shared/base-ui/src/*"],
      "@flowblade/sqlduck/zod": [
        "../../../packages/sqlduck/src/validation/zod/index"
      ],
      "@flowblade/sqlduck/valibot": [
        "../../../packages/sqlduck/src/validation/valibot/index"
      ],
      "@flowblade/sqlduck": ["../../../packages/sqlduck/src/index"],
      "@flowblade/core": ["../../../packages/core/src/index"],
      "@flowblade/core/datasource": ["../../../packages/core/src/datasource/index"],
      "@flowblade/source-duckdb": ["../../../packages/source-duckdb/src/index"],
      "@flowblade/source-kysely": ["../../../packages/source-kysely/src/index"],
      "@flowblade/sql-tag": ["../../../packages/sql-tag/src/index"],
      "@flowblade/sql-tag-format": [
        "../../../packages/sql-tag-format/src/index"
      ],
      "@/components/*": ["./src/components/*"],
      "@/config/*": ["./src/config/*"],
      "@/env/*": ["./src/env/index/*"],
      "@/features/*": ["./src/features/*"],
      "@/providers/*": ["./src/providers/*"],
      "@/redux/*": ["./src/redux/*"],
      "@/server/*": ["./src/server/*"],
      "@/lib/*": ["./src/lib/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"]
  }
}
