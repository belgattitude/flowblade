# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# fonts copied from @fontsource-variable/* (scripts/copy-nextjs-required-local-fonts.ts)
/src/components/fonts/files/

# local data (duckdb extensions + manifest generated by scripts/install-duck-extensions.ts)
/data/
