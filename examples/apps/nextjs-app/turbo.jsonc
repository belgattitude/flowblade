{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["NEXT_BUILD_*", "NEXT_PUBLIC_*"],
      "passThroughEnv": [
        "BLOB_READ_WRITE_TOKEN",
        "BETTER_AUTH_SECRET",
        "DUCKDB_MAIN_DB_DSN",
        "PNPM_CONFIG_*",
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      // We rely on tsconfig path aliases to ease starting
      // Only exception @flowblade/sqlduck that is used for env
      "dependsOn": ["@flowblade/sqlduck#build"],
    },
    "typecheck": {
      // We rely on tsconfig path aliases to ease starting
      // Only exception @flowblade/sqlduck that is used for env
      "dependsOn": ["@flowblade/sqlduck#build"],
    },
    "lint": {
      // We rely on tsconfig path aliases to ease starting
      // Only exception @flowblade/sqlduck that is used for env
      "dependsOn": ["@flowblade/sqlduck#build"],
    },
    // Docker images: never cached, we always want freshly built images.
    // The build tasks don't depend on each other. The images comparison
    // (`pnpm docker:compare`) is not a turbo task, it builds both images itself.
    "docker:build-nodejs": {
      "cache": false,
    },
    "docker:build-bun": {
      "cache": false,
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // We rely on tsconfig path aliases to ease starting
      // Only exception @flowblade/sqlduck that is used for env
      "dependsOn": ["@flowblade/sqlduck#build"],
    },
  },
}
