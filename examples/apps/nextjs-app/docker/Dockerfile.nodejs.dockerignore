# Ignore rules for docker/Dockerfile.nodejs and docker/Dockerfile.bun
# (Dockerfile.bun.dockerignore is a symlink to this file).
# BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile; when it exists
# the root .dockerignore is NOT used for these builds, keep both in sync if needed.

# git (disable if needed in the container)
.git

# dependencies
**/node_modules

# caches
**/.cache
**/tsconfig.tsbuildinfo
**/tsconfig.*.tsbuildinfo
**/.eslintcache

# temp files
**/tmp
**/.tmp
*.tmp

# repository data
**/data/local/duckdb
# nextjs-app local data (duckdb extensions + manifest)
**/apps/nextjs-app/data

# turbo (comment if you want to copy the turbo cache into the image)
**/.turbo
**/.turbo-pruned

# package managers
**/.yarn/*
!**/.yarn/patches
!**/.yarn/releases
!**/.yarn/plugins
.pnp.*

# testing
**/coverage
**/.out/
*.bench.ts
*.test.ts
**/e2e

# Build directories
**/apps/*/.next
**/packages/*/dist

# documentation
docs
**/apps/*/docs
**/packages²²/*/docs
*.md

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.idea/*
.project
.classpath
*.launch
*.sublime-workspace
.vscode/

