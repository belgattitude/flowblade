{
  "name": "@examples/fastify-app",
  "version": "0.1.128",
  "private": true,
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "examples/apps/fastify-app"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "dev": "run clean && cross-env NODE_ENV=development tsx watch ./src/server.ts --watch-path=./src --clear-screen=false | pino-pretty",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit",
    "typecheck-no-paths": "dx-typecheck --project tsconfig.no-paths.json --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@examples/db-sqlserver": "workspace:^",
    "@fast-csv/format": "5.0.8",
    "@fastify/autoload": "6.5.1",
    "@fastify/compress": "9.2.2",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@flowblade/core": "workspace:^",
    "@flowblade/source-duckdb": "workspace:^",
    "@flowblade/source-kysely": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@httpx/assert": "0.18.0",
    "@httpx/dsn-parser": "1.10.1",
    "@httpx/exception": "4.1.0",
    "@httpx/lru": "0.16.0",
    "@httpx/memo-intl": "1.5.2",
    "@httpx/plain-object": "2.3.0",
    "@httpx/treeu": "0.7.1",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "fastify-cli": "8.0.3",
    "fastify-plugin": "6.0.1",
    "kysely": "0.29.7",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "typebox": "1.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.0",
    "@flowblade/dx": "workspace:*",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "execa": "10.2.0",
    "rimraf": "6.1.3",
    "tedious": "20.3.8",
    "tiny-glob": "0.2.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
