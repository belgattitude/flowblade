{
  "name": "@examples/fastify-app",
  "version": "0.1.128",
  "private": true,
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "examples/apps/fastify-app"
  },
  "type": "module",
  "scripts": {
    "dev": "run clean && cross-env NODE_ENV=development tsx watch ./src/server.ts --watch-path=./src --clear-screen=false | pino-pretty",
    "build": "tsc",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck-no-paths": "tsc --project tsconfig.no-paths.json --noEmit",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "fix-staged": "lint-staged --allow-empty"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@examples/db-sqlserver": "workspace:^",
    "@fast-csv/format": "5.0.7",
    "@fastify/autoload": "6.5.0",
    "@fastify/compress": "9.2.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@flowblade/core": "workspace:^",
    "@flowblade/source-duckdb": "workspace:^",
    "@flowblade/source-kysely": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@httpx/assert": "0.18.0",
    "@httpx/dsn-parser": "1.10.0",
    "@httpx/exception": "3.2.0",
    "@httpx/lru": "0.15.0",
    "@httpx/memo-intl": "1.5.0",
    "@httpx/plain-object": "2.2.0",
    "@httpx/treeu": "0.7.0",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.0",
    "fastify-cli": "8.0.0",
    "fastify-plugin": "6.0.0",
    "kysely": "0.29.5",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "tedious": "20.0.0",
    "typebox": "1.3.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "cross-env": "10.1.0",
    "execa": "10.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "tiny-glob": "0.2.9",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
