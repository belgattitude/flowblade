{
  "name": "@docs/website",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "docs"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3008",
    "bun-dev": "bun --bun next dev --port 3008",
    "typegen": "next typegen",
    "build": "next build && run generate-search-idx",
    "build-static": "cross-env NEXT_BUILD_OUTPUT=export next build && run generate-search-idx-static",
    "generate-search-idx": "pagefind --site .next/server/app --output-path public/_pagefind",
    "generate-search-idx-static": "pagefind --site .next/server/app --output-path out/_pagefind",
    "bundle-analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "serve": "sirv out --port 3009",
    "clean": "rimraf ./.next ./out ./public/_pagefind ./coverage ./tsconfig.tsbuildinfo",
    "typecheck": "next typegen && tsc --project tsconfig.json --noEmit",
    "lint": "next typegen && ultracite check",
    "lint-fix": "next typegen && ultracite fix"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.13.11",
    "clsx": "2.1.1",
    "next": "16.3.1",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "@tailwindcss/postcss": "4.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "10.1.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "pagefind": "1.5.2",
    "rimraf": "6.1.3",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.3",
    "tinyrainbow": "3.1.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "ultracite": "7.10.6"
  }
}
