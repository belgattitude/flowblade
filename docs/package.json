{
  "name": "@docs/website",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "docs"
  },
  "type": "module",
  "scripts": {
    "dev": "blume dev --port 3007",
    "bun-dev": "bun --bun blume dev --port 3008",
    "build": "blume build",
    "clean": "rimraf ./.blume ./coverage ./tsconfig.tsbuildinfo",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.11",
    "blume": "2.1.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.32.4",
    "@flowblade/devtools": "workspace:*",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "^24",
        "onFail": "warn"
      },
      {
        "name": "bun",
        "version": "*",
        "onFail": "warn"
      }
    ]
  },
  "engines": {
    "node": "^24"
  }
}
