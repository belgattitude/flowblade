{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@flowblade/devtools/typescript/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  },
  "exclude": ["**/node_modules", "dist", "coverage", "oxlint.config.ts"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.json",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
