{
  "name": "flowblade-monorepo",
  "private": true,
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": "belgattitude/flowblade",
  "type": "module",
  "scripts": {
    "actions:update": "npx actions-up",
    "check:security": "pnpm audit",
    "clean:global-cache": "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false dx-cache clean",
    "clean:turbo": "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false rimraf .turbo",
    "deps:check": "npm-check-updates --configFileName .ncurc.mjs",
    "deps:update": "npm-check-updates --configFileName .ncurc.mjs -u",
    "dx:doctor": "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false dx-doctor",
    "format": "dx-oxfmt --disable-nested-config --write",
    "g:bench": "turbo run bench --concurrency 1",
    "g:bench-codspeed": "turbo run bench-codspeed --concurrency 1",
    "g:build": "turbo run build --filter='!@examples/*' --filter='!@docs/*'",
    "g:build-examples": "turbo run build --filter='@examples/*'",
    "g:build-packages": "pnpm --filter './packages/*' -r --stream run build",
    "g:build-release": "pnpm --filter './packages/*' -r --stream run build-release",
    "g:changeset": "changeset",
    "g:check-dist": "turbo run check-dist --filter='!@examples/**' --filter='!docs/**'",
    "g:check-size": "turbo run check-size --filter='!@examples/**' --filter='!docs/**'",
    "g:ci-coverage-upload": "pnpm -r --if-present --stream run ci-coverage-upload",
    "g:clean": "rimraf ./out ./.turbo-pruned && pnpm clean:global-cache && pnpm -r --parallel --if-present run clean && pnpm clean:turbo",
    "g:codegen": "turbo run codegen",
    "g:docgen": "turbo run docgen --affected",
    "g:format": "turbo run format --continue --concurrency 1",
    "g:lint": "turbo run lint --continue --concurrency 1",
    "g:lint-fix": "turbo run lint-fix --concurrency 1",
    "g:release": "pnpm run g:build-release && pnpm exec changeset publish",
    "g:test": "pnpm -r --parallel --if-present run test",
    "g:test-e2e": "turbo run test-e2e --concurrency 1 --filter='!@examples/*' --filter='!@docs/*'",
    "g:test-e2e-bun": "turbo run test-e2e-bun --concurrency 1 --filter='!@examples/*' --filter='!@docs/*'",
    "g:test-unit": "turbo run test-unit --concurrency 1 --filter='!@examples/*' --filter='!@docs/*'",
    "g:test-unit-browser": "turbo run test-unit-browser --concurrency 1 --filter='!examples/**' --filter='!docs/**'",
    "g:test-unit-bun": "turbo run test-unit-bun --concurrency 1 --filter='!examples/**' --filter='!docs/**'",
    "g:test-unit-coverage": "turbo run test-unit-coverage --concurrency 1 --filter='!@examples/**' --filter='!docs/**'",
    "g:test-unit-deno": "turbo run test-unit-deno --concurrency 1 --filter='!examples/**' --filter='!docs/**'",
    "g:test-unit-examples": "turbo run test-unit --concurrency 1 --filter='@examples/*'",
    "g:typecheck": "turbo run typecheck",
    "g:typecheck-bun": "turbo run typecheck-bun",
    "lint": "dx-oxfmt --check --disable-nested-config --no-error-on-unmatched-pattern && dx-oxlint --disable-nested-config",
    "lint-fix": "dx-oxlint --disable-nested-config --fix && dx-oxfmt --disable-nested-config --write",
    "nuke:node_modules": "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false rimraf --glob '**/node_modules'",
    "pnpm:reinstall": "pnpm pm clean --lockfile --config.verifyDepsBeforeRun=false && pnpm install",
    "skills:sync": "skills experimental_sync -y --exclude 'react-doctor#improve-threejs'"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@flowblade/dx": "workspace:*",
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "lefthook": "2.2.2",
    "npm-check-updates": "23.1.1",
    "npm-run-all2": "9.0.3",
    "pkg-pr-new": "0.0.91",
    "react-doctor": "0.9.18",
    "rimraf": "6.1.3",
    "skills": "1.7.4",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "packageManager": "pnpm@12.15.0",
  "skills": [
    {
      "source": "shadcn/ui",
      "skills": [
        "shadcn"
      ]
    },
    "vercel/turborepo",
    "ag-grid/skills",
    {
      "source": "antfu/skills",
      "skills": [
        "vitest"
      ]
    },
    {
      "source": "mcollina/skills",
      "skills": [
        "node"
      ]
    },
    "reduxjs/redux-toolkit"
  ]
}
