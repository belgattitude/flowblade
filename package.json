{
  "name": "flowblade-monorepo",
  "private": true,
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": "belgattitude/flowblade",
  "type": "module",
  "scripts": {
    "g:clean": "rimraf ./out ./.turbo-pruned && pnpm clean:global-cache && pnpm -r --parallel --if-present run clean && pnpm clean:turbo",
    "clean:global-cache": "rimraf ./.cache",
    "clean:turbo": "rimraf .turbo",
    "g:bench": "turbo run bench --concurrency 1",
    "g:bench-codspeed": "turbo run bench --concurrency 1",
    "g:build": "turbo run build --filter='!@examples/*' --filter='!@docs/*'",
    "g:build-release": "pnpm --filter './packages/*' -r --stream run build-release",
    "g:build-packages": "pnpm --filter './packages/*' -r --stream run build",
    "g:build-examples": "turbo run build --filter='@examples/*'",
    "g:docgen": "turbo run docgen --affected",
    "g:test": "pnpm -r --parallel --if-present run test",
    "g:test-unit": "turbo run test-unit --filter='!@examples/*' --filter='!@docs/*'",
    "g:test-unit-examples": "turbo run test-unit --filter='@examples/*'",
    "g:test-e2e": "turbo run test-e2e --filter='!@examples/*' --filter='!@docs/*'",
    "g:test-e2e-bun": "turbo run test-e2e-bun --filter='!@examples/*' --filter='!@docs/*'",
    "g:test-unit-coverage": "turbo run test-unit-coverage --filter='!@examples/**' --filter='!docs/**'",
    "g:test-unit-bun": "turbo run test-unit-bun --filter='!examples/**' --filter='!docs/**'",
    "g:test-unit-deno": "turbo run test-unit-deno --filter='!examples/**' --filter='!docs/**'",
    "g:test-unit-edge": "turbo run test-unit-edge --filter='!examples/**' --filter='!docs/**'",
    "g:test-unit-browser": "turbo run test-unit-browser --filter='!examples/**' --filter='!docs/**'",
    "g:lint": "turbo run lint --continue --concurrency 1",
    "g:lint-fix": "turbo run lint-fix --concurrency 1",
    "g:format": "turbo run format --continue --concurrency 1",
    "g:typecheck": "turbo run typecheck",
    "g:lint-staged-files": "lint-staged --allow-empty",
    "g:fix-all-files": "pnpm -r --parallel --if-present run fix-all-files",
    "g:changeset": "changeset",
    "g:codegen": "turbo run codegen",
    "g:check-dist": "turbo run check-dist --filter='!@examples/**' --filter='!docs/**'",
    "g:check-size": "turbo run check-size --filter='!@examples/**' --filter='!docs/**'",
    "g:check-pub": "turbo run check-pub --filter='!@examples/**' --filter='!docs/**'",
    "g:release": "pnpm run g:build-release && pnpm exec changeset publish",
    "g:ci-coverage-upload": "pnpm -r --if-present --stream run ci-coverage-upload",
    "deps:check": "npm-check-updates --configFileName .ncurc.cjs",
    "deps:update": "npm-check-updates --configFileName .ncurc.cjs -u",
    "check:install": "pnpm install --frozen-lockfile",
    "check:security": "pnpm audit",
    "syncpack:format": "syncpack format",
    "syncpack:check": "syncpack lint --dependency-types dev --source \"package.json\" --source \"packages/*/package.json\"",
    "syncpack:list": "syncpack list --dependency-types prod,dev --source \"package.json\" --source \"packages/*/package.json\"",
    "nuke:node_modules": "rimraf --glob '**/node_modules'",
    "skills:update": "npx skills update"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@flowblade/devtools": "workspace:*",
    "cross-env": "10.1.0",
    "is-ci": "4.1.0",
    "lefthook": "2.1.14",
    "npm-check-updates": "23.1.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "picocolors": "1.1.1",
    "pkg-pr-new": "0.0.88",
    "react-doctor": "0.9.14",
    "rimraf": "6.1.3",
    "shell-quote": "1.10.0",
    "syncpack": "15.3.3",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.6.0",
  "resolutions-help": {
    "esbuild": "Generally is safe to keep only the latest version (vite, vitest, tsup...)"
  }
}
