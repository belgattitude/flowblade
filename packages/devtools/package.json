{
  "name": "@flowblade/devtools",
  "version": "0.0.1",
  "description": "Internal devtools for flowblade monorepo",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "flowblade-monorepo-source": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./typescript/tsconfig.base.json": "./src/typescript/tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf --glob ./dist ./build ./coverage ./_release './tsconfig*.tsbuildinfo'",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/ui": "4.1.11",
    "browserslist": "4.28.8",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0-rc.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.6",
    "vitest": "4.1.11"
  }
}
