{
  "name": "@flowblade/devtools",
  "version": "0.0.1",
  "private": true,
  "description": "Internal devtools for flowblade monorepo",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "flowblade-monorepo-source": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./typescript/tsconfig.base.json": "./src/typescript/tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "format": "oxfmt --write",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@codspeed/vitest-plugin": "5.7.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "browserslist": "4.29.3",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "eslint-plugin-security": "4.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "1.14.0",
    "oxlint-tsgolint": "7.0.2003",
    "rimraf": "6.1.3",
    "tinybench": "6.2.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@types/node": "^26.6.4",
    "eslint-plugin-security": "^4.2.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tailwindcss": "^1.14.0",
    "oxlint-tsgolint": "^7.0.2003",
    "ultracite": "^7.12.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": false
    },
    "eslint-plugin-security": {
      "optional": false
    },
    "oxlint": {
      "optional": false
    },
    "oxfmt": {
      "optional": false
    },
    "oxlint-tailwindcss": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": false
    },
    "ultracite": {
      "optional": false
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
