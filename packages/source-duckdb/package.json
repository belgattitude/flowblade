{
  "name": "@flowblade/source-duckdb",
  "version": "0.28.2",
  "description": "DuckDB node datasource",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/source-duckdb"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "?build-release": "When https://github.com/atlassian/changesets/issues/432 has a solution we can remove this trick",
    "build": "tsdown",
    "build-release": "tsdown",
    "bench-disabled": "vitest bench --run",
    "bench-codspeed-disabled": "cross-env CODSPEED=1 vitest bench --run",
    "bench-watch-disabled": "vitest bench",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "check-dist": "run-s check-dist-esm check-dist-cjs",
    "check-dist-cjs": "es-check es2022 './dist/**/*.cjs' --not './dist/*.map.js'",
    "check-dist-esm": "es-check es2022 './dist/**/*.mjs' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack && publint",
    "check-size": "size-limit",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "tsdown --watch",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-e2e": "vitest --config=vitest.e2e.config.ts run",
    "test-e2e-watch": "vitest --config=vitest.e2e.config.ts --ui --api 4516",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest --ui --api 4515",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck-build": "tsc --project tsconfig.build.json --noEmit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F flowblade-source-duckdb --dir ./coverage"
  },
  "dependencies": {
    "@flowblade/core": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@logtape/logtape": "^2.3.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codspeed/vitest-plugin": "5.7.1",
    "@duckdb/node-api": "1.5.5-r.5",
    "@edge-runtime/vm": "5.0.0",
    "@faker-js/faker": "10.6.0",
    "@flowblade/core": "workspace:^",
    "@flowblade/devtools": "workspace:*",
    "@flowblade/sql-tag": "workspace:^",
    "@logtape/pretty": "2.3.7",
    "@size-limit/esbuild": "14.0.0",
    "@size-limit/file": "14.0.0",
    "@vitest/coverage-istanbul": "5.0.2",
    "@vitest/ui": "5.0.2",
    "browserslist": "4.29.0",
    "browserslist-to-esbuild": "2.1.1",
    "core-js": "3.50.0",
    "cross-env": "10.1.0",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "execa": "10.0.1",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "size-limit": "14.0.0",
    "sql-template-tag": "5.2.1",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@duckdb/node-api": "^1.5.3-r.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
