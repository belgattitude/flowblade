{
  "name": "@flowblade/source-duckdb",
  "version": "0.31.1",
  "description": "DuckDB node datasource",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/source-duckdb"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "?build-release": "When https://github.com/atlassian/changesets/issues/432 has a solution we can remove this trick",
    "bench": "vitest bench --run --reporter=verbose",
    "bench-codspeed": "cross-env CODSPEED=1 vitest bench --run",
    "bench-watch": "vitest bench --reporter=verbose",
    "build": "dx-build",
    "build-release": "dx-build",
    "check-dist": "dx-escheck",
    "check-size": "dx-size-limit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F flowblade-source-duckdb --dir ./coverage",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "dx-build --watch",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-deno": "deno run test-unit",
    "test-unit-watch": "vitest --ui --api 4516 --coverage.enabled=true --coverage.reporter=html",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck-build": "tsc --project tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@flowblade/core": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@logtape/logtape": "^2.4.1"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "5.7.1",
    "@duckdb/node-api": "1.5.6-r.1",
    "@faker-js/faker": "10.6.0",
    "@flowblade/core": "workspace:^",
    "@flowblade/dx": "workspace:*",
    "@flowblade/sql-tag": "workspace:^",
    "@logtape/pretty": "2.4.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.4",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "execa": "10.1.0",
    "npm-run-all2": "9.0.3",
    "rimraf": "6.1.3",
    "sql-template-tag": "5.2.1",
    "tinybench": "6.2.2",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@duckdb/node-api": "^1.5.3-r.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
