{
  "name": "@flowblade/sql-tag",
  "version": "0.4.0",
  "description": "Raw sql template literal",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/sql-tag"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "?build-release": "When https://github.com/atlassian/changesets/issues/432 has a solution we can remove this trick",
    "build": "tsdown",
    "build-release": "tsdown",
    "bench-disabled": "vitest bench --run",
    "bench-codspeed-disabled": "cross-env CODSPEED=1 vitest bench --run",
    "bench-watch-disabled": "vitest bench",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "check-dist": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-size": "size-limit",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "tsdown --watch",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-e2e": "vitest --config=vitest.e2e.config.ts run",
    "test-e2e-watch": "vitest --config=vitest.e2e.config.ts  --ui --api 4516",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-edge": "vitest run --environment edge-runtime",
    "test-unit-watch": "vitest --ui --api 4515",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck-build": "tsc --project tsconfig.build.json --noEmit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F flowblade-sql-tag --dir ./coverage"
  },
  "dependencies": {
    "sql-template-tag": "^5.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@codspeed/vitest-plugin": "5.7.1",
    "@edge-runtime/vm": "5.0.0",
    "@electric-sql/pglite": "0.5.8",
    "@flowblade/devtools": "workspace:*",
    "@size-limit/esbuild": "14.0.0",
    "@size-limit/file": "14.0.0",
    "@vitest/coverage-istanbul": "5.0.2",
    "@vitest/ui": "5.0.2",
    "browserslist": "4.29.0",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "execa": "10.0.1",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "size-limit": "14.0.0",
    "sql-formatter": "15.9.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
