{
  "name": "@flowblade/sqlduck",
  "version": "0.37.5",
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/sqlduck"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/tests/data/*": "./tests/data/*",
    "#/tests/utils/*": "./tests/utils/*"
  },
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./filesystem": {
      "flowblade-monorepo-source": "./src/filesystem/index.ts",
      "types": "./dist/filesystem/index.d.mts",
      "default": "./dist/filesystem/index.mjs"
    },
    "./zod": {
      "flowblade-monorepo-source": "./src/zod/index.ts",
      "types": "./dist/validation/zod/index.d.mts",
      "default": "./dist/validation/zod/index.mjs"
    },
    "./valibot": {
      "flowblade-monorepo-source": "./src/valibot/index.ts",
      "types": "./dist/validation/valibot/index.d.mts",
      "default": "./dist/validation/valibot/index.mjs"
    },
    "./kysely": {
      "flowblade-monorepo-source": "./src/kysely/index.ts",
      "types": "./dist/integrations/kysely/index.d.mts",
      "default": "./dist/integrations/kysely/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "build": "tsdown",
    "build-release": "tsdown",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "bench": "vitest bench --run",
    "bench-report": "tsx scripts/generate-benchmarks.ts",
    "bench-bun": "bun --bun run vitest bench --run",
    "bench-deno": "deno run -A npm:vitest bench --run",
    "bench-mitata": "node --experimental-strip-types --expose-gc bench/run_mitata.ts",
    "bench-mitata-bun": "bun --expose-gc bench/run_mitata.ts",
    "bench-codspeed": "cross-env CODSPEED=1 vitest bench --run",
    "bench-watch": "vitest bench",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-deno": "deno run test-unit",
    "test-unit-watch": "vitest --ui",
    "test-e2e": "vitest -c vitest.e2e.config.ts run",
    "test-e2e-bun": "bun --bun run vitest -c vitest.e2e.config.ts run",
    "test-e2e-watch": "vitest -c vitest.e2e.config.ts --ui",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "format": "oxfmt --write",
    "check-dist": "es-check --config=.escheckrc.json",
    "check-pub": "publint",
    "check-size-disabled": "size-limit",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@flowblade/core": "workspace:^",
    "@flowblade/source-duckdb": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@httpx/assert": "^0.18.0",
    "@httpx/dsn-parser": "^1.10.0",
    "@httpx/plain-object": "^2.2.0",
    "@logtape/logtape": "^2.3.6",
    "@standard-schema/spec": "^1.1.0",
    "is-safe-filename": "0.1.1",
    "p-queue": "^9.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.28.0",
    "@duckdb/node-api": "1.5.5-r.5",
    "@faker-js/faker": "10.6.0",
    "@flowblade/devtools": "workspace:*",
    "@flowblade/source-kysely": "workspace:^",
    "@httpx/assert": "0.18.0",
    "@mitata/counters": "0.0.8",
    "@size-limit/esbuild": "14.0.0",
    "@size-limit/file": "14.0.0",
    "@testcontainers/mssqlserver": "12.1.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.2",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/ui": "5.0.1",
    "ansis": "4.4.0",
    "browserslist-to-esbuild": "2.1.1",
    "core-js": "3.50.0",
    "cross-env": "10.1.0",
    "es-check": "9.8.0",
    "es-toolkit": "1.52.0",
    "esbuild": "0.28.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "execa": "10.0.1",
    "is-in-ci": "2.0.0",
    "kysely": "0.29.6",
    "mitata": "1.0.34",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "publint": "0.3.24",
    "regexp.escape": "2.0.1",
    "rimraf": "6.1.3",
    "size-limit": "14.0.0",
    "sql-formatter": "15.8.2",
    "tarn": "3.1.2",
    "tedious": "20.3.0",
    "testcontainers": "12.1.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "valibot": "1.5.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "kysely": "^0.29.0",
    "valibot": "^1.4.2"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "valibot": {
      "optional": true
    }
  }
}
