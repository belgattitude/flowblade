{
  "name": "@flowblade/sqlduck",
  "version": "0.36.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./filesystem": {
      "types": "./dist/filesystem/index.d.mts",
      "default": "./dist/filesystem/index.mjs"
    },
    "./zod": {
      "types": "./dist/validation/zod/index.d.mts",
      "default": "./dist/validation/zod/index.mjs"
    },
    "./valibot": {
      "types": "./dist/validation/valibot/index.d.mts",
      "default": "./dist/validation/valibot/index.mjs"
    },
    "./kysely": {
      "types": "./dist/integrations/kysely/index.d.mts",
      "default": "./dist/integrations/kysely/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "license": "MIT",
  "homepage": "https://github.com/belgattitude/flowblade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/sqlduck"
  },
  "scripts": {
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "build": "tsdown",
    "build-release": "yarn build && rimraf ./_release && yarn pack && mkdir ./_release && tar zxvf ./package.tgz --directory ./_release && rm ./package.tgz",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "bench": "vitest bench --run",
    "bench-bun": "bun --bun run vitest bench --run",
    "bench-deno": "deno run -A npm:vitest bench --run",
    "bench-mitata": "node --experimental-strip-types --expose-gc bench/run_mitata.ts",
    "bench-mitata-bun": "bun --expose-gc bench/run_mitata.ts",
    "bench-codspeed": "cross-env CODSPEED=1 vitest bench --run",
    "bench-watch": "vitest bench",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-deno": "deno run test-unit",
    "test-unit-watch": "vitest --ui",
    "test-e2e": "vitest -c vitest.e2e.config.ts run",
    "test-e2e-bun": "bun --bun run vitest -c vitest.e2e.config.ts run",
    "test-e2e-watch": "vitest -c vitest.e2e.config.ts --ui",
    "typecheck": "tsgo --project tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs,.mts,.cts --cache --cache-location ../../../.cache/eslint/sqlduck.eslintcache",
    "fix-staged": "lint-staged --allow-empty",
    "check-dist": "es-check --config=.escheckrc.json",
    "check-pub": "publint",
    "check-size-disabled": "size-limit"
  },
  "dependencies": {
    "@flowblade/core": "workspace:^",
    "@flowblade/source-duckdb": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@httpx/assert": "^0.18.0",
    "@httpx/dsn-parser": "^1.10.0",
    "@httpx/plain-object": "^2.2.0",
    "@logtape/logtape": "^2.3.1",
    "@standard-schema/spec": "^1.1.0",
    "is-safe-filename": "0.1.1",
    "p-queue": "^9.3.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@duckdb/node-api": "^1.5.3-r.2",
    "kysely": "^0.29.0",
    "valibot": "^1.3.1"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "valibot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@belgattitude/eslint-config-bases": "8.19.1",
    "@dotenvx/dotenvx": "2.21.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "@faker-js/faker": "10.6.0",
    "@flowblade/source-kysely": "workspace:^",
    "@httpx/assert": "0.18.0",
    "@mitata/counters": "0.0.8",
    "@size-limit/esbuild": "13.0.3",
    "@size-limit/file": "13.0.3",
    "@testcontainers/mssqlserver": "12.1.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "ansis": "4.3.1",
    "browserslist-to-esbuild": "2.1.1",
    "core-js": "3.50.0",
    "cross-env": "10.1.0",
    "es-check": "9.6.4",
    "es-toolkit": "1.50.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "execa": "10.0.1",
    "is-in-ci": "2.0.0",
    "kysely": "0.29.5",
    "mitata": "1.0.34",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "regexp.escape": "2.0.1",
    "rimraf": "6.1.3",
    "size-limit": "13.0.3",
    "sql-formatter": "15.8.2",
    "tarn": "3.1.2",
    "tedious": "20.0.0",
    "testcontainers": "12.1.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "valibot": "1.4.2",
    "vitest": "4.1.10"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "directory": "_release/package"
  }
}
