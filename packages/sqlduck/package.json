{
  "name": "@flowblade/sqlduck",
  "version": "0.42.1",
  "homepage": "https://github.com/belgattitude/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/sqlduck"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#tests/data/*": "./tests/data/*",
    "#tests/utils/*": "./tests/utils/*"
  },
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./filesystem": {
      "flowblade-monorepo-source": "./src/filesystem/index.ts",
      "types": "./dist/filesystem/index.d.mts",
      "default": "./dist/filesystem/index.mjs"
    },
    "./zod": {
      "flowblade-monorepo-source": "./src/validation/zod/index.ts",
      "types": "./dist/validation/zod/index.d.mts",
      "default": "./dist/validation/zod/index.mjs"
    },
    "./valibot": {
      "flowblade-monorepo-source": "./src/validation/valibot/index.ts",
      "types": "./dist/validation/valibot/index.d.mts",
      "default": "./dist/validation/valibot/index.mjs"
    },
    "./kysely": {
      "flowblade-monorepo-source": "./src/integrations/kysely/index.ts",
      "types": "./dist/integrations/kysely/index.d.mts",
      "default": "./dist/integrations/kysely/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "dx-bench",
    "bench-bun": "dx-bench --runtime=bun",
    "bench-codspeed": "dx-bench-codspeed",
    "bench-deno": "deno run -A npm:vitest bench --run",
    "bench-mitata": "node --experimental-strip-types --expose-gc bench/run_mitata.ts",
    "bench-mitata-bun": "bun --expose-gc bench/run_mitata.ts",
    "bench-report": "tsx scripts/generate-benchmarks.ts",
    "bench-watch": "dx-bench --watch",
    "build": "dx-build",
    "build-release": "dx-build",
    "check": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "check-dist": "dx-escheck",
    "check-size-disabled": "dx-size-limit",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "fix": "dx-oxlint --fix && dx-oxfmt --write",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-e2e": "dotenvx run --ignore=MISSING_ENV_FILE -f .env.test.local -f env.test -- vitest -c vitest.e2e.config.ts run",
    "test-e2e-bun": "bun --bun run vitest -c vitest.e2e.config.ts run",
    "test-e2e-watch": "vitest -c vitest.e2e.config.ts --ui",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-deno": "deno run test-unit",
    "test-unit-watch": "vitest --ui --api 4516 --coverage.enabled=true --coverage.reporter=html",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flowblade/core": "workspace:^",
    "@flowblade/source-duckdb": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@httpx/assert": "^0.18.0",
    "@httpx/dsn-parser": "^1.10.1",
    "@httpx/plain-object": "^2.3.0",
    "@logtape/logtape": "^2.4.2",
    "@standard-schema/spec": "^1.1.0",
    "glob": "13.0.6",
    "is-safe-filename": "0.1.1",
    "nanoid": "6.0.2",
    "p-queue": "^10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@faker-js/faker": "10.6.0",
    "@flowblade/dx": "workspace:*",
    "@flowblade/source-kysely": "workspace:^",
    "@httpx/assert": "0.18.0",
    "@mitata/counters": "0.0.8",
    "@testcontainers/mssqlserver": "12.2.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "26.6.5",
    "@typescript/typescript6": "6.0.2",
    "ansis": "4.4.0",
    "es-toolkit": "1.52.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "execa": "10.2.0",
    "is-in-ci": "2.0.0",
    "kysely": "0.29.7",
    "mitata": "1.0.34",
    "npm-run-all2": "9.0.3",
    "regexp.escape": "2.0.1",
    "rimraf": "6.1.3",
    "sql-formatter": "15.9.0",
    "tarn": "3.1.2",
    "tedious": "20.3.8",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "kysely": "^0.29.0",
    "valibot": "^1.4.2"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "valibot": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
