{
  "name": "@flowblade/source-kysely",
  "version": "1.9.5",
  "description": "Kysely datasource",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/source-kysely"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "vitest bench --run --reporter=verbose",
    "bench-codspeed": "cross-env CODSPEED=1 vitest bench --run",
    "bench-e2e": "dotenvx run --ignore=MISSING_ENV_FILE -f .env.test.local -f env.test -- vitest bench --config=vitest.e2e.config.ts --run --reporter=verbose",
    "bench-watch": "vitest bench --reporter=verbose",
    "build": "tsdown",
    "build-release": "tsdown",
    "check-dist": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-size": "size-limit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F flowblade-source-kysely --dir ./coverage",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "tsdown --watch",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "format": "oxfmt --write",
    "kysely": "kysely",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "test": "vitest run",
    "test-e2e": "dotenvx run --ignore=MISSING_ENV_FILE -f .env.test.local -f env.test -- vitest --config=vitest.e2e.config.ts run",
    "test-e2e-watch": "vitest --config=vitest.e2e.config.ts --ui",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest --ui --api 4518 --coverage.enabled=true --coverage.reporter=html",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck-build": "tsc --project tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@flowblade/core": "workspace:^",
    "@flowblade/sql-tag": "workspace:^",
    "@httpx/assert": "^0.18.0",
    "@httpx/dsn-parser": "^1.10.0",
    "@httpx/plain-object": "^2.2.0",
    "@logtape/logtape": "^2.4.1",
    "type-fest": "^5.10.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@codspeed/vitest-plugin": "5.7.1",
    "@dotenvx/dotenvx": "2.34.2",
    "@faker-js/faker": "10.6.0",
    "@flowblade/devtools": "workspace:*",
    "@logtape/pretty": "2.4.1",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@testcontainers/mssqlserver": "12.2.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.4",
    "browserslist": "4.29.3",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "eslint-plugin-security": "4.2.0",
    "execa": "10.1.0",
    "is-in-ci": "2.0.0",
    "kysely": "0.29.6",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-import-zod": "1.0.1",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "size-limit": "14.2.0",
    "tarn": "3.1.2",
    "tedious": "20.3.7",
    "tinybench": "6.2.2",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "ultracite": "8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "kysely": "^0.28.10 || ^0.29.0",
    "tarn": "^3.0.2",
    "tedious": "^19.2.0 || ^20.0.0"
  },
  "peerDependenciesMeta": {
    "tarn": {
      "optional": true
    },
    "tedious": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
