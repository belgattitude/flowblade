{
  "name": "@flowblade/core",
  "version": "0.5.0",
  "description": "Core contracts, interfaces and utilities",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "?build-release": "When https://github.com/atlassian/changesets/issues/432 has a solution we can remove this trick",
    "build": "tsdown",
    "build-release": "tsdown",
    "bench": "vitest bench --run",
    "bench-codspeed-disabled": "cross-env CODSPEED=1 vitest bench --run",
    "bench-watch-disabled": "vitest bench",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "check-dist": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-size": "size-limit",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "tsdown --watch",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-edge": "vitest run --environment edge-runtime",
    "test-unit-watch": "vitest --ui --api 4515 --coverage.enabled=true --coverage.reporter=html",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck-build": "tsc --project tsconfig.build.json --noEmit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F flowblade-core --dir ./coverage",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@httpx/plain-object": "^2.2.0",
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codspeed/vitest-plugin": "5.7.1",
    "@edge-runtime/vm": "5.0.0",
    "@faker-js/faker": "10.6.0",
    "@flowblade/devtools": "workspace:*",
    "@flowblade/sql-tag": "workspace:^",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "browserslist": "4.29.3",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "execa": "10.1.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "size-limit": "14.2.0",
    "tinybench": "6.2.1",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
