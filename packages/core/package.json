{
  "name": "@flowblade/core",
  "description": "Core contracts, interfaces and utilities",
  "version": "0.2.29",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "homepage": "https://belgattitude.github.io/flowblade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/core"
  },
  "keywords": [],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "?build-release": "When https://github.com/atlassian/changesets/issues/432 has a solution we can remove this trick",
    "build": "tsdown",
    "build-release": "run build",
    "bench": "vitest bench --run",
    "bench-codspeed-disabled": "cross-env CODSPEED=1 vitest bench --run",
    "bench-watch-disabled": "vitest bench",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "check-dist": "run-s check-dist-esm check-dist-cjs",
    "check-dist-cjs": "es-check es2022 './dist/**/*.cjs' --not './dist/*.map.js'",
    "check-dist-esm": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack && publint",
    "check-size": "size-limit",
    "clean": "rimraf --glob ./dist ./build ./coverage ./_release './tsconfig*.tsbuildinfo'",
    "dev": "tsdown --watch",
    "fix-staged": "lint-staged --allow-empty",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs,.mts,.cts --cache --cache-location ../../.cache/eslint/core.eslintcache",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-edge": "vitest run --environment edge-runtime",
    "test-unit-watch": "vitest --ui --api 4515",
    "typecheck": "tsgo --project tsconfig.json --noEmit",
    "typecheck-build": "tsgo --project tsconfig.build.json --noEmit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F flowblade-core --dir ./coverage"
  },
  "dependencies": {
    "@httpx/plain-object": "^2.1.12",
    "typescript-result": "3.5.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@belgattitude/eslint-config-bases": "8.18.0",
    "@codspeed/vitest-plugin": "5.7.1",
    "@edge-runtime/vm": "5.0.0",
    "@faker-js/faker": "10.5.0",
    "@flowblade/sql-tag": "workspace:^",
    "@size-limit/esbuild": "13.0.1",
    "@size-limit/file": "13.0.1",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/ui": "4.1.10",
    "browserslist": "4.28.7",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "es-check": "9.6.4",
    "esbuild": "0.28.1",
    "eslint": "8.57.1",
    "execa": "10.0.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "rimraf": "6.1.3",
    "size-limit": "13.0.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "type-fest": "5.8.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
