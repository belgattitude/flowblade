{
  "name": "@flowblade/core",
  "version": "0.6.1",
  "description": "Core contracts, interfaces and utilities",
  "keywords": [],
  "homepage": "https://belgattitude.github.io/flowblade",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/flowblade.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "flowblade-monorepo-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "?build-release": "When https://github.com/atlassian/changesets/issues/432 has a solution we can remove this trick",
    "bench": "dx-bench",
    "bench-codspeed-disabled": "dx-bench-codspeed",
    "bench-watch-disabled": "dx-bench --watch",
    "build": "dx-build",
    "build-release": "dx-build",
    "check": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "check-dist": "dx-escheck",
    "check-size": "dx-size-limit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F flowblade-core --dir ./coverage",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "dx-build --watch",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "fix": "dx-oxlint --fix && dx-oxfmt --write",
    "format": "dx-oxfmt --write",
    "format2": "dx-oxfmt",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-deno": "deno run test-unit",
    "test-unit-watch": "vitest --ui --api 4515 --coverage.enabled=true --coverage.reporter=html",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-build": "dx-typecheck --project tsconfig.build.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@httpx/plain-object": "^2.2.0",
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@flowblade/dx": "workspace:*",
    "@flowblade/sql-tag": "workspace:^",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "execa": "10.1.0",
    "npm-run-all2": "9.0.3",
    "rimraf": "6.1.3",
    "tinybench": "6.2.2",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
